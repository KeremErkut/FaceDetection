<Window x:Class="FaceDetection.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Face Detection Pro" Height="650" Width="950"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20">
            <TextBlock DockPanel.Dock="Left" 
                       Text="AI Face Detection Engine" 
                       FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Faces Detected: " FontSize="18" Foreground="#7F8C8D"/>
                <TextBlock Text="{Binding FaceCount}" 
                           FontSize="18" FontWeight="Bold" Foreground="#E74C3C" Margin="5,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#2C3E50" CornerRadius="12" ClipToBounds="True" BorderThickness="1" BorderBrush="#BDC3C7">
            <Image Source="{Binding CurrentFrame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
            <Button Content="START CAMERA" 
                    Command="{Binding StartCameraCommand}" 
                    Width="160" Height="45" Margin="15,0"
                    Background="#27AE60" Foreground="White" FontSize="14" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="STOP CAMERA" 
                    Command="{Binding StopCameraCommand}" 
                    Width="160" Height="45" Margin="15,0"
                    Background="#C0392B" Foreground="White" FontSize="14" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>